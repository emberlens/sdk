{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Emberlens project recipe",
  "description": "The labels and export settings of a shared project. See SPEC.md section 10.",
  "type": "object",
  "required": ["emberlens_project_version", "shared_id", "revision", "name", "description", "category", "root_category", "classes", "sub_categories", "export"],
  "properties": {
    "emberlens_project_version": {"const": 1},
    "about": {"type": "string"},
    "shared_id": {"$ref": "#/$defs/id"},
    "revision": {"type": "integer", "minimum": 1},
    "name": {"$ref": "#/$defs/name"},
    "description": {"type": "string", "maxLength": 5000},
    "category": {"type": "string", "maxLength": 200},
    "root_category": {"$ref": "#/$defs/name"},
    "classes": {
      "type": "array",
      "maxItems": 2000,
      "items": {
        "type": "object",
        "required": ["id", "name", "colour", "order", "retired"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "name": {"$ref": "#/$defs/name"},
          "colour": {"type": "integer", "minimum": 0, "maximum": 4294967295, "description": "ARGB"},
          "order": {"type": "integer", "minimum": 0},
          "retired": {"type": "boolean", "description": "Old boxes stay. No new boxes get this class."}
        }
      }
    },
    "sub_categories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "order", "default_value", "values"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "name": {"$ref": "#/$defs/name"},
          "order": {"type": "integer", "minimum": 0},
          "default_value": {"oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
          "values": {
            "type": "array",
            "maxItems": 2000,
            "items": {
              "type": "object",
              "required": ["id", "name", "order", "only_for_classes"],
              "properties": {
                "id": {"$ref": "#/$defs/id"},
                "name": {"$ref": "#/$defs/name"},
                "order": {"type": "integer", "minimum": 0},
                "only_for_classes": {"oneOf": [{"type": "array", "items": {"$ref": "#/$defs/id"}}, {"type": "null"}]}
              }
            }
          }
        }
      }
    },
    "export": {
      "type": "object",
      "required": ["format", "longest_side", "colour_space", "jpeg_quality", "split", "label_style", "separator", "lowercase"],
      "properties": {
        "format": {"enum": ["coco", "yolo", "voc"]},
        "longest_side": {"oneOf": [{"type": "integer", "minimum": 1}, {"type": "null"}]},
        "colour_space": {"enum": ["rgb", "grayscale"]},
        "jpeg_quality": {"type": "integer", "minimum": 1, "maximum": 100},
        "split": {
          "type": "object",
          "required": ["train", "val", "test"],
          "properties": {
            "train": {"type": "number"},
            "val": {"type": "number"},
            "test": {"type": "number"}
          }
        },
        "label_style": {"enum": ["joined", "separateFields"]},
        "separator": {"type": "string", "pattern": "^[A-Za-z0-9_.\\-+]{1,3}$"},
        "lowercase": {"type": "boolean"}
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 200}
  }
}
